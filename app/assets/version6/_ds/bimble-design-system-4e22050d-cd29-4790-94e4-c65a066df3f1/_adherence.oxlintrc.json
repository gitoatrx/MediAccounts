{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "patient-waiting-room/**",
              "ui_kits/clinic-onboarding/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Inter, Montserrat."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-foreground",
      "--background",
      "--bg-glow",
      "--border",
      "--card",
      "--card-foreground",
      "--destructive",
      "--destructive-foreground",
      "--font-display",
      "--font-mono",
      "--font-sans",
      "--foreground",
      "--ink",
      "--ink-foreground",
      "--input",
      "--muted",
      "--muted-fg",
      "--muted-foreground",
      "--popover",
      "--popover-foreground",
      "--primary",
      "--primary-05",
      "--primary-10",
      "--primary-20",
      "--primary-fg",
      "--primary-foreground",
      "--radius",
      "--radius-2xl",
      "--radius-card",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--radius-xl",
      "--ring",
      "--secondary",
      "--secondary-foreground",
      "--shadow-card",
      "--shadow-sm",
      "--slate-200",
      "--slate-50"
    ],
    "tokenKinds": {
      "--background": "color",
      "--foreground": "color",
      "--card": "color",
      "--card-foreground": "color",
      "--popover": "color",
      "--popover-foreground": "color",
      "--primary": "color",
      "--primary-foreground": "color",
      "--secondary": "color",
      "--secondary-foreground": "color",
      "--muted": "color",
      "--muted-foreground": "color",
      "--accent": "color",
      "--accent-foreground": "color",
      "--destructive": "color",
      "--destructive-foreground": "color",
      "--border": "color",
      "--input": "color",
      "--ring": "color",
      "--primary-05": "color",
      "--primary-10": "color",
      "--primary-20": "color",
      "--slate-50": "color",
      "--slate-200": "color",
      "--ink": "color",
      "--ink-foreground": "color",
      "--radius": "radius",
      "--radius-sm": "radius",
      "--radius-md": "radius",
      "--radius-lg": "radius",
      "--radius-xl": "radius",
      "--radius-2xl": "radius",
      "--radius-card": "radius",
      "--radius-pill": "radius",
      "--shadow-sm": "shadow",
      "--shadow-card": "shadow",
      "--font-display": "font",
      "--font-sans": "font",
      "--font-mono": "font",
      "--bg-glow": "color",
      "--muted-fg": "color",
      "--primary-fg": "color"
    },
    "fontFamilies": [
      "Inter",
      "Montserrat"
    ]
  }
}