{
  "expo": {
    "name": "MediAccounts",
    "slug": "MediAccounts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mediaccounts-app-icon.png",
    "splash": {
      "image": "./assets/mediaccounts-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#030A2B"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.oatrx.mediaccounts",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mediaccounts-adaptive-icon.png",
        "backgroundImage": "./assets/mediaccounts-icon-background.png",
        "backgroundColor": "#152344"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MediAccounts",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MediAccounts to choose bill images.",
          "cameraPermission": "Allow MediAccounts to take bill photos."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      "./plugins/withHighSamplingRateSensors"
    ]
  }
}
