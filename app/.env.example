# Android emulator uses 10.0.2.2 to reach the Node server on this computer.
# For a physical phone, use this computer's LAN address, for example:
# EXPO_PUBLIC_MEDIACCOUNTS_API_URL=http://192.168.1.50:4000
EXPO_PUBLIC_MEDIACCOUNTS_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web client ID from Firebase console -> Authentication -> Sign-in method -> Google -> Web SDK configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
