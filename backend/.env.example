PORT=4000
CLIENT_ORIGIN=http://localhost:8081
DATABASE_URL=postgresql://postgres:root@localhost:5432/mediaccounts
OTP_SECRET=replace-with-a-long-random-value
# auto: email sign-in codes when the SMTP settings below are filled in, otherwise print them to this console.
# smtp / log force one behaviour.
EMAIL_MODE=auto
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character App Password>
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_USER=you@yourdomain.com, SMTP_PASS=<mailbox password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MediAccounts <you@yourdomain.com>
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=adminmedi@gmail.com
# Optional Firebase Admin credentials. When present, verified OTP logins also
# receive a Firebase custom token and API routes accept Firebase ID tokens.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or point to a downloaded service-account JSON kept outside source control.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Address search on Add business (Google Places API (New)). Keep this key on the server only.
GOOGLE_MAPS_API_KEY=AIzaSyBzuzGR9_XoLdb7nx-L9UdPPmIwZyiSOdM
# Comma-separated country codes for address suggestions.
GOOGLE_PLACES_REGIONS=ca
# auto (default) tries Places API (New) and falls back to the classic Places API; or force new / legacy.
GOOGLE_PLACES_API=auto
# Encrypts full bank account numbers saved for Export Bank. Use a long random value in production
# (falls back to OTP_SECRET when empty). Changing it makes previously saved account numbers unreadable.
BANK_DATA_KEY=
# Google Sign-In: the Web client ID the app uses (same as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
GOOGLE_WEB_CLIENT_ID=

# CSV import categories (Azure OpenAI, same setup as OATRx). Leave empty to use keyword rules only.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CATEGORY_DEPLOYMENT=gpt-5-mini
# Deployment that reads bill photos (must accept images). Defaults to the category deployment.
AZURE_OPENAI_BILL_DEPLOYMENT=gpt-5-mini
